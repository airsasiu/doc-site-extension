{
  "manifest_version": 3,
  "name": "DocSite Search Helper",
  "version": "1.0",
  "description": "在文档站点中搜索 Markdown 内容。支持实时搜索预览，快速定位文档位置。按 Alt+` 打开搜索侧边栏。",
  "permissions": [
    "activeTab",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.grapecity.com.cn/*"
  ],
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Alt+Comma",
        "mac": "Alt+Comma"
      },
      "description": "打开搜索侧边栏"
    }
  },
  "action": {
    "default_title": "DocSite Search Helper"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
